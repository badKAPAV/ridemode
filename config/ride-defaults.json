{
  "schemaVersion": 1,
  "sourceOfTruth": "proposed",
  "persistenceRule": "Seed only on first run; DataStore and Room user overrides survive updates and are never reset from this file.",
  "orientation": "landscape_in_ride",
  "keepAwakeWhileVisible": true,
  "grid": {"rowHeightDp":52,"allowedRowHeightDp":[52,60,68],"cellShape":"square","minimumColumns":12,"minimumRows":6,"countRule":"wholeCellsFromDeviceCanvas","largeScreenMinimumCellDp":52},
  "defaultPages": [
    {"id":"music","title":"Music","enabled":true,"widgetTypes":["music","volume"]},
    {"id":"sos","title":"SOS / Favorites","enabled":true,"widgetTypes":["sos_contacts"]},
    {"id":"clock_weather","title":"Clock & Weather","enabled":true,"widgetTypes":["clock","battery"]},
    {"id":"calls","title":"Calls","enabled":true,"widgetTypes":["calls"]},
    {"id":"notifications","title":"Notifications","enabled":true,"widgetTypes":["notifications"]},
    {"id":"touring","title":"Touring custom","enabled":true,"widgetTypes":["music","clock","volume","sos_contacts","maps_shortcut","assistant"]}
  ],
  "oled": {"enabled":false,"timeoutSeconds":30,"allowedTimeoutSeconds":[15,30,60,120,300],"style":"CLASSIC","allowedStyles":["CLASSIC","ROW"],"outlineText":true,"reduceWindowBrightness":false},
  "notificationPopup": {"enabled":true,"priority":"HIGH","foregroundOnly":true},
  "privacyMode": false,
  "reducedMotion": false,
  "rideStartAnimation": true
}
